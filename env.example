## App URL (fallback when request origin is unavailable; auth links use whichever domain the user is on)
NEXT_PUBLIC_SITE_URL=https://rhappaccess.com

## Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Supabase service role (required for admin panel + open tracking)
SUPABASE_SERVICE_ROLE_KEY=

## YouTube Data API (recommended — reliable Shorts search + validation)
YOUTUBE_API_KEY=

## RapidAPI (AI comments + YouTube video search)
RAPIDAPI_KEY=
RAPIDAPI_HOST=chatgpt-42.p.rapidapi.com

## Scraper API (optional)
SCRAPER_API_KEY=
